 rpmmacrosdir = get_option('rpmmacrosdir')
 if rpmmacrosdir != 'no'
-        rpmmacrosdir = prefixdir / rpmmacrosdir
+        rpmmacrosdir = usrprefixdir / rpmmacrosdir
 endif
