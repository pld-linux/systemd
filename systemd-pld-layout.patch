PLD installs systemd into / with a separate /usr (prefix=/): keep in /usr what the 254
split-usr layout kept there (tmpfiles.d, sysusers.d, sysctl.d, user units, catalog, ...) and
export the same paths in systemd.pc, libsystemd.pc, libudev.pc and sd-path.

 meson.build                      | 51 +++++++++++++++++++-------------
 src/core/systemd.pc.in           | 16 +++++-----
 src/libsystemd/libsystemd.pc.in  |  4 +--
 src/libsystemd/sd-path/sd-path.c | 10 +++----
 src/libudev/libudev.pc.in        |  4 +--
 5 files changed, 47 insertions(+), 38 deletions(-)

diff --git a/meson.build b/meson.build
index ce6898f..7d3c6fd 100644
--- a/meson.build
+++ b/meson.build
@@ -125,6 +125,14 @@ if not prefixdir.startswith('/')
 endif
 
 prefixdir_noslash = '/' + prefixdir.strip('/')
+# PLD keeps /usr unmerged: with prefix=/ the files that do not need to be on the
+# root fs (as in the old split-usr layout) still go below /usr
+if prefixdir == '/'
+        prefixdir_noslash = ''
+        usrprefixdir = '/usr'
+else
+        usrprefixdir = prefixdir
+endif
 bindir = prefixdir / get_option('bindir')
 sbindir = prefixdir / (split_bin ? 'sbin' : 'bin')
 sbin_to_bin = split_bin ? '../bin/' : ''
@@ -149,27 +157,27 @@ polkitpkladir = localstatedir / 'lib/polkit-1/localauthority/10-vendor.d'
